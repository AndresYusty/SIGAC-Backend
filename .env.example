# Copie este archivo como .env y ajuste los valores (NO suba .env al repositorio)
DB_NAME=sigac
DB_USER=sigac
DB_PASSWORD=sigac_dev
DB_ROOT_PASSWORD=root_dev
# Mínimo 32 caracteres
JWT_SECRET=cambiar-este-secreto-en-produccion-sigac-2026-minimo-32
SIGAC_ADMIN_EMAIL=admin@sigac.local
SIGAC_ADMIN_PASSWORD=Admin12345*
SIGAC_DEV_EMAIL=dev@sigac.local
SIGAC_DEV_PASSWORD=Dev12345*
# true = crea Universidad/Sede/Facultad/Programa y usuarios demo (clave Demo12345*)
SIGAC_SEED_DEMO=true
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
MAIL_ENABLED=true
# Solo true detrás de un proxy inverso de confianza (para registrar la IP real del firmante)
TRUST_PROXY_HEADERS=false
