# Local development variables. Copy as .env in this folder (Spring reads it at startup).
# DO NOT commit .env. For production with Docker use the .env.example next to docker-compose.yml.
# Values marked "dev" are insecure defaults: change them in production.

# --- Database -------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/sigac?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USER=root
DB_PASSWORD=
# update (default) or validate
DDL_AUTO=update

# --- Security (dev: change in production) ---------------------------------------
# At least 32 characters. Production: openssl rand -base64 48
JWT_SECRET=change-this-secret-in-production-sigac-2026-minimum-32
# Administrator created on the first start
SIGAC_ADMIN_EMAIL=admin@sigac.local
SIGAC_ADMIN_PASSWORD=Admin12345*
# true = creates University/Campus/Faculty/Program and demo users (password Demo12345*). Development only.
SIGAC_SEED_DEMO=true

# --- URLs ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Public base of the API (email download links)
PUBLIC_API_URL=http://localhost:8080/api/v1
# Only true behind a trusted reverse proxy (to record the signer's real IP)
TRUST_PROXY_HEADERS=false

# --- File storage -------------------------------------------------------------
# local = SIGAC_STORAGE_PATH directory | s3 = SIGAC_S3_BUCKET bucket
SIGAC_STORAGE_TYPE=local
SIGAC_STORAGE_PATH=./storage
SIGAC_S3_BUCKET=
SIGAC_S3_REGION=

# --- Email ----------------------------------------------------------------------
# false = emails are only logged
MAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Brevo's regional server certificate name differs from smtp-relay.brevo.com.
SMTP_CHECK_IDENTITY=false
SMTP_FROM=noresponder.consejo.usco@gmail.com
