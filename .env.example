# Copy this file as .env and adjust the values (DO NOT commit .env to the repository)
DB_NAME=sigac
DB_USER=sigac
DB_PASSWORD=sigac_dev
DB_ROOT_PASSWORD=root_dev
# At least 32 characters
JWT_SECRET=change-this-secret-in-production-sigac-2026-minimum-32
SIGAC_ADMIN_EMAIL=admin@sigac.local
SIGAC_ADMIN_PASSWORD=Admin12345*
# true = creates University/Campus/Faculty/Program and demo users (password Demo12345*)
SIGAC_SEED_DEMO=true
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
MAIL_ENABLED=true
# Only true behind a trusted reverse proxy (to record the signer's real IP)
TRUST_PROXY_HEADERS=false
